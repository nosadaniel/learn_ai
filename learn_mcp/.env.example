# Choose your LLM provider + model. Any pair supported by LangChain's
# init_chat_model works (langchain-anthropic / langchain-google-genai /
# langchain-ollama are installed by default).
LLM_PROVIDER=ollama        # anthropic | google_genai | ollama
LLM_MODEL=llama3.1  # e.g. gemini-2.0-flash (google_genai), llama3.1 (ollama)

# Provide the key matching LLM_PROVIDER (uncomment the relevant one)
#ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434   # optional, defaults to localhost
