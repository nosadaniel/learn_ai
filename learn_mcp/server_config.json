{
    "mcpServers": {
        "filesystem": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "."
            ],
            "env": {
                "NPM_CONFIG_LOGLEVEL": "silent"
            },
            "transport": "stdio"
        },
        "research": {
            "command": "uv",
            "args": [
                "run",
                "research_server.py"
            ],
            "transport": "stdio"
        },
        "fetch": {
            "command": "uvx",
            "args": [
                "--with",
                "mcp<2",
                "mcp-server-fetch"
            ],
            "transport": "stdio"
        }
    }
}