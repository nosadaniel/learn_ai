{
    "mcpServers": {
        "filesystem": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "."
            ],
            "env": {
                "NPM_CONFIG_LOGLEVEL": "silent"
            },
            "transport": "stdio"
        },
        "research": {
            "url": "http://localhost:8080/mcp",
            "transport": "http"
        },
        "fetch": {
            "command": "uvx",
            "args": [
                "--with",
                "mcp<2",
                "mcp-server-fetch"
            ],
            "transport": "stdio"
        }
    }
}