# ===========================================================
# Stage 1: Builder (Compiles & installs dependencies)
# ===========================================================
FROM python:3.12-slim AS builder

WORKDIR /app

# Copy uv binary from official Astral image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Copy dependency lock files first to leverage caching
COPY pyproject.toml uv.lock ./

# Install dependencies into a standalone virtual environment (/app/.venv)
RUN uv sync --frozen --no-dev --no-install-project

# ===========================================================
# Stage 2: Final Production Runner (Minimal & Hardened)
# ===========================================================
FROM python:3.12-slim AS runner

WORKDIR /app

# 1. Prevent .pyc files & enable immediate stdout/stderr logging
# 2. Add the virtual environment to PATH so 'python' uses /app/.venv
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    PORT=8080

# Create a dedicated non-root user and group
RUN groupadd -r appgroup && useradd -r -g appgroup -u 10001 appuser

# Copy only the compiled virtual environment from the builder stage
COPY --from=builder --chown=appuser:appgroup /app/.venv /app/.venv

# Copy application source code
COPY --chown=appuser:appgroup research_server.py .

# Create the papers directory for data persistence and assign ownership
RUN mkdir -p /app/papers && chown -R appuser:appgroup /app

# Switch to non-root user
USER appuser

EXPOSE 8080

# Start server directly using python from the venv
ENTRYPOINT ["python", "research_server.py"]
